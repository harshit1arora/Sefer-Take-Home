# Sefer Entry Workspace — environment template
# Copy to .env in the repository root. Never commit a real API key.

# Google Gemini API key (backend only). Create one at https://aistudio.google.com/apikey
# Uploaded PDFs are sent to Google's Gemini API for extraction. Review Google's current free-tier data terms before sending sensitive commercial documents.
GEMINI_API_KEY=

# Optional Gemini model ID. Current documented default: gemini-3.8-flash
# This is a multimodal model that supports PDF input. Free-tier quotas and availability depend on your account.
GEMINI_MODEL=gemini-3.8-flash

# Backend port (default 3001).
# PORT=3001

# Bind address; loopback-only by default.
# HOST=127.0.0.1

# Vite proxy target (default http://127.0.0.1:3001).
# SEFER_API_URL=http://127.0.0.1:3001

# Optional custom schema directory.
# SEFER_SCHEMA_DIR=
